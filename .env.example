# ==============================================================================
# Frontend Configuration (Google AI Studio / Vite — safe for browser exposure)
# NEVER prefix API secrets (such as RESEND_API_KEY) with VITE_.
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Deployed Supabase Edge Function URLs (no secrets):
# Example: https://<project-ref>.supabase.co/functions/v1/contact
# Example: https://<project-ref>.supabase.co/functions/v1/newsletter
VITE_CONTACT_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=

# ==============================================================================
# Supabase Edge Function Secrets (configure in Supabase Secrets, NOT in AI Studio)
# Access server-side only via Deno.env.get("<SECRET_NAME>")
# ==============================================================================
# RESEND_API_KEY=
# GROQ_API_KEY=
